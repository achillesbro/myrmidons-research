# Myrmidons risk engine: liq_capacity writer — oneshot service triggered by
# liq-capacity.timer. Install to /etc/systemd/system/ alongside the timer.
# Reads the live MNEMON store, writes ONLY <data>/outputs/ (append-only).
[Unit]
Description=Myrmidons risk engine — liq_capacity writer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/myrmidons-research
ExecStart=/home/ubuntu/myrmidons-research/run_liq_capacity.sh
# stdout/stderr are captured by journald: `journalctl -u liq-capacity`.
TimeoutStartSec=1200
