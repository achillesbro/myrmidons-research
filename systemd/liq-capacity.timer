# Fires liq-capacity.service once a day. Quotes accumulate hourly either
# way (the run is idempotent and processes every unprocessed cycle), so the
# cadence only sets how fresh the output table is. Install alongside the
# service and enable with: sudo systemctl enable --now liq-capacity.timer
[Unit]
Description=Run the liq_capacity risk-engine writer daily

[Timer]
# 00:20 UTC: after the day boundary, between MNEMON's 5-minute ticks.
OnCalendar=*-*-* 00:20:00 UTC
# Run a missed cycle once on boot if the VPS was down at the scheduled time.
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
